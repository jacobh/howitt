    "@remix-run/eslint-config": "^2.17.5",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "overrides": {
    "@emotion/utils": "^1.4"
