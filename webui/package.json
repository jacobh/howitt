{
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "start": "wrangler dev",
    "check:worker": "wrangler deploy --dry-run",
    "deploy:worker": "wrangler deploy",
    "typecheck": "tsc",
    "test": "bun test",
    "gql-codegen": "graphql-codegen && bun run format",
    "gql-watch": "graphql-codegen -w",
    "format": "prettier --write app",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint --ext .js,.jsx,.ts,.tsx app"
  },
  "dependencies": {
    "@apollo/client": "^4.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@remix-run/cloudflare": "2.17.5",
    "@remix-run/react": "^2.17.5",
    "@tanstack/react-query": "^5.102.8",
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.17.25",
    "axios": "^1.20.0",
    "cardinal-direction": "^1.1.1",
    "change-case": "^5.4.4",
    "cookie": "^2.0.1",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "ionicons": "^8.1.0",
    "isbot": "^5.2.2",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "mutative": "^1.3.0",
    "ol": "^10.10.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone-esm": "^15.2.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rxjs": "^7.8.2",
    "ts-pattern": "^5.9.0",
    "use-mutative": "^1.3.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/fragment-matcher": "^7.1.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@parcel/watcher": "^2.6.0",
