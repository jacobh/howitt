{
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "miniflare": "5.20260911.0-alpha",
    "wrangler": "^4.131.1"
  },
  "scripts": {
    "build:worker": "bash scripts/build-worker.sh",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "build:jobs": "bash scripts/build-worker.sh howitt-worker",
    "dev:jobs": "wrangler dev --config wrangler.jobs.toml",
    "check:jobs": "wrangler deploy --config wrangler.jobs.toml --dry-run",
    "deploy:jobs": "wrangler deploy --config wrangler.jobs.toml",
    "build:migrations": "bash scripts/build-worker.sh howitt-migrations",
    "dev:migrations": "wrangler dev --config wrangler.migrations.toml",
    "check:migrations": "wrangler deploy --config wrangler.migrations.toml --dry-run",
    "deploy:migrations": "wrangler deploy --config wrangler.migrations.toml",
    "test:observability": "bun test scripts/tests/resolver-tracing.test.ts"
  }
}
